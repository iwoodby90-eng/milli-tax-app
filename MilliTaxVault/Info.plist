<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MILLI_API_BASE_URL</key>
	<string>https://milli-tax-vault-api.onrender.com</string>
	<key>MILLI_CLIENT_API_KEY</key>
	<string>$(MILLI_CLIENT_API_KEY)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Sora-Regular.ttf</string>
		<string>Sora-Medium.ttf</string>
		<string>Sora-SemiBold.ttf</string>
		<string>Sora-Bold.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Milli uses your location while a mileage trip is active to record deductible business miles.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Milli can continue an active mileage trip in the background so business miles are not lost when you switch apps or lock your iPhone.</string>
</dict>
</plist>
