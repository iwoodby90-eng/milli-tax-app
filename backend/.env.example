# Copy to .env for local development. Never commit real values.
ENVIRONMENT=sandbox

# Postgres connection string (Render Postgres or local)
DATABASE_URL=postgresql://user:password@localhost:5432/milli

# Plaid - sandbox first, then production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://<your-render-service>.onrender.com/plaid/webhook
PLAID_REDIRECT_URI=

# Shared key the iOS app sends as X-Milli-Client-Key
CLIENT_API_KEY=
