# Copy to .env for local development. Never commit real values.
ENVIRONMENT=sandbox

# Postgres connection string (Render Postgres or local)
DATABASE_URL=postgresql://user:password@localhost:5432/milli

# Plaid - account connectivity, Auth and transaction data
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://<your-render-service>.onrender.com/plaid/webhook
PLAID_REDIRECT_URI=

# Column - banking / ACH money movement
# Sandbox keys begin test_; production keys begin live_.
COLUMN_API_KEY=
COLUMN_ENV=sandbox
COLUMN_BASE_URL=https://api.column.com
# Optional in sandbox: Milli can create a simulated debit program automatically.
# Required for production card issuing after Column provisions the live program.
COLUMN_CARD_PROGRAM_ID=
# Required before any physical card can be issued. Must point to the approved
# MILLI card template; virtual sandbox cards do not require it.
COLUMN_CARD_TEMPLATE_ID=

# Required ACH compliance classification. Do not guess these in production:
# configure only after the approved authorization/origination policy is set.
# Allowed by this build: PPD or WEB.
COLUMN_ACH_CREDIT_SEC_CODE=
COLUMN_ACH_DEBIT_SEC_CODE=

# Server-verified Sign in with Apple
APPLE_SIGN_IN_AUDIENCE=com.milli.taxvault
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_CHALLENGE_TTL_MINUTES=10
