# Copy to .env for local development. Never commit real values.
ENVIRONMENT=sandbox

# Postgres connection string (Render Postgres or local)
DATABASE_URL=postgresql://user:password@localhost:5432/milli

# Plaid - sandbox first, then production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://<your-render-service>.onrender.com/plaid/webhook
PLAID_REDIRECT_URI=

# Shared key the iOS app sends as X-Milli-Client-Key
CLIENT_API_KEY=

# Column BaaS
COLUMN_API_KEY=
COLUMN_BASE_URL=https://api.column.com
COLUMN_WEBHOOK_SECRET=

# Apple IAP (App Store Server API)
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ENVIRONMENT=sandbox
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# Apple Identity (Verify with Wallet API)
APPLE_IDENTITY_MERCHANT_ID=
APPLE_IDENTITY_PRIVATE_KEY=

# Rate limiting (requests per minute per user)
RATE_LIMIT_PER_MINUTE=60

# Audit log retention (days)
AUDIT_RETENTION_DAYS=365