# ═══════════════════════════════════════════════════════════════════
# Milli — Environment Variables
# Copy to .env for local development. Never commit the real .env file.
# ═══════════════════════════════════════════════════════════════════

# ── Current backend runtime (backend/server.py) ────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=milli
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost,https://localhost

# Frontend / Capacitor
REACT_APP_API_URL=http://localhost:8000

# ── Plaid: account linking and transaction sync ───────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# ── Stripe: subscriptions / checkout ──────────────────────────────
# server.py currently reads STRIPE_API_KEY; card modules read
# STRIPE_SECRET_KEY. Use the same Stripe secret key for both variables.
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CARD_WEBHOOK_SECRET=

# ── Milli AI through Emergent integrations ────────────────────────
EMERGENT_LLM_KEY=

# ── Apple Push Notification service ───────────────────────────────
APNS_TEAM_ID=
APNS_KEY_ID=
# Paste the complete AuthKey_XXXX.p8 PEM value. Literal \n is supported.
APNS_KEY_P8=
APNS_BUNDLE_ID=app.milli.tax
APNS_ENV=sandbox

# ── TaxBandits: TIN matching / 1099 workflows ─────────────────────
TAXBANDITS_CLIENT_ID=
TAXBANDITS_CLIENT_SECRET=
TAXBANDITS_USER_TOKEN=
TAXBANDITS_AUTH_URL=https://testoauth.expressauth.net/v2/tbsauth
TAXBANDITS_API_BASE=https://testapi.taxbandits.com/v1.7.3

# ── Optional / future production providers ────────────────────────
# Brokerage
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Receipt OCR
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Identity verification / KYC
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=

# Social authentication
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=

# ── Legacy PostgreSQL API only (backend/main.py) ───────────────────
# These are retained solely for migration/reference work. The current app
# and Docker runtime use MongoDB through backend/server.py.
DATABASE_URL=postgresql://milli:milli_dev_2026@localhost:5432/milli_tax
REDIS_URL=redis://localhost:6379/0
