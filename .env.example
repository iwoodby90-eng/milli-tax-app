# ═══════════════════════════════════════════════════════════════════
# Milli Tax Vault — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ═══════════════════════════════════════════════════════════════════

# Flask server
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-random-string

# Database
DATABASE_URL=sqlite:///milli.db

# Plaid integration
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
# Webhook URL for real-time transaction notifications
# Register this in Plaid dashboard: https://your-domain.com/api/plaid/webhook
PLAID_WEBHOOK_URL=https://your-domain.com/api/plaid/webhook

# Apple Push Notifications
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_ID=your-apns-key-id
APNS_PRIVATE_KEY_PATH=path/to/AuthKey.p8
APNS_BUNDLE_ID=app.milli.tax

# TaxBandits
TAXBANDITS_CLIENT_ID=your-taxbandits-client-id
TAXBANDITS_SECRET=your-taxbandits-secret

# Frontend API URL (for Capacitor)
REACT_APP_API_URL=http://localhost:5000

# Optional: Sentry / observability
SENTRY_DSN=