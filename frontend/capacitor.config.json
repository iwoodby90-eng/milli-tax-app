{
  "appId": "app.milli.tax",
  "appName": "Milli",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#000000",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#000000",
      "showSpinner": false
    }
  }
}
