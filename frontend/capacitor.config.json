{
  "appId": "app.milli.tax",
  "appName": "Milli",
  "webDir": "build",
  "bundledWebRuntime": false,
  "loggingBehavior": "debug",
  "server": {
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "milli",
    "allowNavigation": []
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#050607",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 450,
      "launchAutoHide": true,
      "backgroundColor": "#050607",
      "showSpinner": false,
      "fadeOutDuration": 200
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#050607",
      "overlaysWebView": true
    }
  }
}
