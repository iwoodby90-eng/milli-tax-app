{
  "appId": "app.milli.tax",
  "appName": "Milli Tax Vault",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#050607",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 10000,
      "launchAutoHide": false,
      "backgroundColor": "#050607",
      "showSpinner": false,
      "androidScale": 1,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
