<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Milli</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.6.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Milli uses the camera to scan 1099 forms and tax documents for automatic data entry.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Milli needs photo library access to import tax document images and receipts for deduction tracking.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Milli saves tax document scans and receipt images to your photo library for your records.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Milli uses your location to automatically track mileage for tax deductions while you drive.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Milli uses background location to automatically track mileage deductions even when the app is closed.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Milli uses Face ID to protect your financial data and Tax Vault.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Milli sends reminders for quarterly tax payments, payout confirmations, and vault milestones.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Milli does not track you across other companies' apps or websites.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>millitax</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.milli.tax</string>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.finance</string>
</dict>
</plist>